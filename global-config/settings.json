  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/tab-title-hook.sh --bell"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/tab-title-hook.sh --bell"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/tab-title-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/tab-title-hook.sh --activity"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/save-for-later-merge-hook.sh"
          }
        ]
      },
      {
        "matcher": "mcp__db__describe_table|mcp__db__list_tables|mcp__knowledge__search_knowledge",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/db-record-described.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); sid=$(printf '%s' \"$input\" | jq -r '.session_id // empty' 2>/dev/null); [ -n \"$sid\" ] || sid=\"$CLAUDE_CODE_SESSION_ID\"; [ -n \"$sid\" ] && rm -f \"$HOME/.claude/tab-titles/$sid\" \"$HOME/.claude/tab-titles/$sid.notified\" \"$HOME/.claude/tab-titles/$sid.did\" \"$HOME/.claude/tab-titles/$sid.log\" \"$HOME/.claude/db-described/$sid\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE '(^|[^a-zA-Z0-9_-])git[[:space:]]+stash([[:space:]]|$)'; then jq -n '{hookSpecificOutput: {hookEventName: \"PreToolUse\", permissionDecision: \"deny\", permissionDecisionReason: \"Blocked: `git stash` is forbidden in this codebase (CLAUDE.md). Use `git show HEAD:path/to/file` or `git diff HEAD -- path` to compare against HEAD. To check if a test failure is pre-existing, run the test on a clean checkout or trust that if your diff does not touch related code, the failure is not yours. Never stash, even briefly, even with explicit paths.\"}}'; fi"
          },
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -Eq 'python3?[[:space:]]+-c[[:space:]]+\"' && echo \"$cmd\" | grep -q '\\\\\"'; then jq -n '{hookSpecificOutput: {hookEventName: \"PreToolUse\", permissionDecision: \"deny\", permissionDecisionReason: \"Blocked: a `python3 -c \\\"...\\\"` body contains backslash-escaped double-quotes (\\\\\\\"). This leaks a literal backslash into Python source -> SyntaxError: unexpected character after line continuation. Fix: single-quote the -c body (python3 -c '\"'\"'...'\"'\"') and use single-quoted Python string literals (o.get('\"'\"'level'\"'\"')), so no double-quote needs escaping; or pipe a  python3 - <<'\"'\"'PY'\"'\"' ... PY  heredoc (quoted delimiter, no interpolation) with single-quoted Python literals.\"}}'; fi"
          },
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/memory-pressure-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/repo-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__db__query_database",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/db-describe-first-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__search_code",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/github-search-code-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jackkief/.claude/scripts/tab-title-default.sh"
          }
        ]
      }
